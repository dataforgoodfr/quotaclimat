# Advertising classification (quotaclimat/data_ingestion/advertising/s03_classification).
# Copy to .advertising.env (git-ignored) and fill in.

# Postgres (connect_to_db defaults)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=barometre

# Every stage only handles the ads with an occurrence on or after this date (YYYY-MM-DD)
CLASSIFICATION_START_DATE=2026-01-01

# Advertising bucket (Scaleway), where the ad videos are stored
BUCKET=
BUCKET_SECRET=
ADVERTISING_BUCKET_NAME=
ADVERTISING_BUCKET_REGION=fr-par

# VLM endpoint (OpenAI-compatible)
VLM_API_URL=https://endpoint.com/v1
VLM_API_TOKEN=
VLM_MODEL_NAME=qwen3.8-27b-fp8
# VLM sampling: they shape the answers as much as the prompts. Empty: the defaults below.
# With thinking, the temperature should be 1.0 and the presence penalty 0.0; without, temperature 0.0.
VLM_TEMPERATURE=1.0
VLM_TOP_P=0.9
VLM_TOP_K=20
VLM_PRESENCE_PENALTY=0.0
VLM_REPETITION_PENALTY=1.0
VLM_REASONING_EFFORT=low
# 1 or 0
VLM_ENABLE_THINKING=1

# Speech-to-text endpoint (OpenAI-compatible /audio/transcriptions), for transcription/audio
ASR_API_URL=
ASR_API_TOKEN=
ASR_MODEL_NAME=
ASR_LANGUAGE=fr

# OCR endpoint (OpenAI-compatible, PaddleOCR-VL), for transcription/ocr
OCR_API_URL=
OCR_API_TOKEN=
OCR_MODEL_NAME=

# Google Sheet holding the taxonomy, the brand dictionary and the brand review tabs
ADVERTISING_SPREADSHEET_ID=
ADVERTISING_GOOGLE_SERVICE_ACCOUNT_JSON=secrets/service-account.json
