#!/bin/sh
# Managed by Ansible (corlab, role postgres). Restricts the ports published by Docker
# (Postgres, Metabase) to the allowed source IPs. Docker publishes ports around UFW, so the
# filter has to sit in the DOCKER-USER chain. Matching on the ORIGINAL destination port
# (conntrack) is needed because packets are already DNATed to the container port when they
# reach DOCKER-USER. Traffic between containers (Metabase -> postgres:5432) is not DNATed
# and is unaffected. A port without allowed IPs is not filtered.
set -eu
{% for rule in docker_user_rules %}

# --- port {{ rule.port }}: chain {{ rule.chain }}
{% if rule.ips | length > 0 %}
iptables -N {{ rule.chain }} 2>/dev/null || true
iptables -F {{ rule.chain }}
{% for ip in rule.ips %}
iptables -A {{ rule.chain }} -s {{ ip }} -j RETURN
{% endfor %}
iptables -A {{ rule.chain }} -j DROP
# DOCKER-USER is created by Docker; jump to our chain once, first
iptables -C DOCKER-USER -p tcp -m conntrack --ctorigdstport {{ rule.port }} --ctdir ORIGINAL -j {{ rule.chain }} 2>/dev/null \
  || iptables -I DOCKER-USER 1 -p tcp -m conntrack --ctorigdstport {{ rule.port }} --ctdir ORIGINAL -j {{ rule.chain }}
{% else %}
# No allowed IPs: remove a filter left by a previous run
iptables -D DOCKER-USER -p tcp -m conntrack --ctorigdstport {{ rule.port }} --ctdir ORIGINAL -j {{ rule.chain }} 2>/dev/null || true
iptables -F {{ rule.chain }} 2>/dev/null || true
iptables -X {{ rule.chain }} 2>/dev/null || true
{% endif %}
{% endfor %}
