  "cards": [
    {
      "dot": "emerald",
      "title": "Reading the tier",
      "items": [
        "Every table is clean and already filtered: no status or prediction code to filter on",
        "chaine_id joins every table to chaine; emission_jour_id joins cas_mesinformation to emission_jour",
        "Names are in French, snake_case, unit as suffix (_sec, _min, _pct from 0 to 100)"
      ]
    },
    {
      "dot": "orange",
      "title": "Built last",
      "items": [
        "Built by entrypoints/curated.sh after dbt.sh, then documented in Metabase",
        "Nothing in dbt reads a curated table",
        "Columns are added, never renamed or removed, because Metabase questions depend on them"
      ]
    }
  ]
