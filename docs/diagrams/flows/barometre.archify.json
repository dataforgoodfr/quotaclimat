      "dot": "amber",
      "title": "Idempotence",
      "items": [
        "API_DATA_OVERWRITE=1: step 1 rewrites existing S3 objects for the window",
        "Step 2 builds a hash id per row and upserts it",
        "Step 3 looks back days_back + 1 days"
      ]
