  "cards": [
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "with_rrs=false skips every step except barometre and metabase-sync",
        "A failed subflow fails main-pipeline and stops the remaining steps; metabase-sync (allowFailure) only marks the run WARNING"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inputs passed down",
      "items": [
        "days_back and start_date (default today) go to extended-perimeter and barometre only",
        "rrs-climate gets no dates and resumes from the rrs DB; rrs-insecurity and rrs-pollution use their default days_back=1",
        "metabase-sync runs last, once every table its Metabase queries read is built"
      ]
    }
  ]
