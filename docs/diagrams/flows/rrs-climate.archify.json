  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger and inputs",
      "items": [
        "Run by main-pipeline twice: source=extended (run_clustering=false), then source=barometre",
        "source picks the DB, host, port and channel list; output always goes to the rrs DB",
        "No dates given: steps 1-2 resume from the latest segment/case date in rrs"
      ]
    },
    {
      "dot": "amber",
      "title": "Clustering scope",
      "items": [
        "Clustering reads rrs.cases for the subject, whatever the source",
        "So cases imported by the extended run are clustered by the next barometre run"
      ]
    }
