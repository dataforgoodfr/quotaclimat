  "cards": [
    {
      "dot": "cyan",
      "title": "Trigger and inputs",
      "items": [
        "Run by main-pipeline twice: source=extended (run_clustering=false), then source=barometre",
        "days_back defaults to 1 (DAYS_PRIOR) for all three steps; start_date/end_date override it",
        "Reads raw transcripts from S3, not the keywords table"
      ]
    },
    {
      "dot": "amber",
      "title": "Detection rules",
      "items": [
        "A segment needs a validated keyword and no high-risk false positive",
        "Enough non-validated keywords together also count",
        "Only segments Mistral labels oui become cases (no Label Studio)"
      ]
    }
