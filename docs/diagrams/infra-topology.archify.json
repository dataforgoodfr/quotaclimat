  "cards": [
    {
      "dot": "amber",
      "title": "Single-host bottleneck",
      "items": [
        "Traefik, Kestra, GlitchTip and every daily flow's task containers all run on one shared Elastic Metal server",
        "No dev/prod split for the orchestrator itself: Kestra uses namespaces, GlitchTip uses projects, on the same host"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two compute paths",
      "items": [
        "Most daily flow tasks run as sibling containers via the host's docker.sock (io.kestra.plugin.docker.Run)",
        "RRS migrate/clustering/import and i18n misinformation jobs run as separate Scaleway Serverless Jobs instead"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared Postgres instance",
      "items": [
        "`rdb-poc` hosts the kestra and glitchtip databases alongside barometre's own database",
        "RRS and extended-perimeter live on a separate RDB instance"
      ]
    }
  ]
