# Per-country credentials for the barometre-i18n flow: ONE single-line JSON object keyed by
# country code (bel, bel-fla, deu, esp, pol). Keep it on one line, inside single quotes.
# Each key comes from Scaleway Secret Manager (project climate-safeguards-prod):
#   bucket_access = access-key-<country>, bucket_secret = secret-key-<country>,
#   label_studio_url = https://<namespace>-labelstudio-<country>-<env>.functions.fnc.fr-par.scw.cloud
#   label_studio_token = labelstudio-<country>-token  (<country> = belgium, belgium-flanders, ...)
# Build it with: jq -n -c --arg a "$ACCESS" --arg s "$SECRET" --arg t "$TOKEN" --arg u "$URL" '{bel:{bucket_access:$a,bucket_secret:$s,label_studio_token:$t,label_studio_url:$u}}'
# Example (placeholder values), shown multiline for readability:
#   export I18N_COUNTRY_SECRETS="$(jq -c . <<'EOF'
#   {
#     "bel":     {"bucket_access": "SCW...", "bucket_secret": "...", "label_studio_token": "...", "label_studio_url": "https://..."},
#     "bel-fla": {"bucket_access": "...",    "bucket_secret": "...", "label_studio_token": "...", "label_studio_url": "https://..."},
#     "deu":     {"bucket_access": "...",    "bucket_secret": "...", "label_studio_token": "...", "label_studio_url": "https://..."},
#     "esp":     {"bucket_access": "...",    "bucket_secret": "...", "label_studio_token": "...", "label_studio_url": "https://..."},
#     "pol":     {"bucket_access": "...",    "bucket_secret": "...", "label_studio_token": "...", "label_studio_url": "https://..."}
#   }
#   EOF
#   )"  

export I18N_COUNTRY_SECRETS=

