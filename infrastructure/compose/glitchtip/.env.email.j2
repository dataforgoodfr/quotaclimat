{# Loaded after .env, so these values override EMAIL_URL/DEFAULT_FROM_EMAIL there.
   Empty BREVO_SMTP_* => file stays empty and .env keeps consolemail:// (emails printed in logs). #}
{% if brevo_smtp_login and brevo_smtp_key %}
EMAIL_URL=smtp+tls://{{ brevo_smtp_login | urlencode | replace('/', '%2F') }}:{{ brevo_smtp_key | urlencode | replace('/', '%2F') }}@{{ brevo_smtp_host }}:{{ brevo_smtp_port }}
DEFAULT_FROM_EMAIL={{ brevo_from_email }}
{% endif %}
