# S3 object storage (Scaleway, S3-compatible), rendered by Ansible.
# Docs: https://glitchtip.com/documentation/install#file-storage

# File storage: sourcemaps, attachments; also used by cold storage.
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_ACCESS_KEY_ID={{ glitchtip_s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ glitchtip_s3_secret_key }}
AWS_STORAGE_BUCKET_NAME={{ glitchtip_s3_bucket }}
AWS_S3_ENDPOINT_URL={{ glitchtip_s3_endpoint }}
# Not listed in the GlitchTip docs (django-storages option); harmless if ignored.
AWS_S3_REGION_NAME={{ glitchtip_s3_region }}

# Cold storage: older events/logs archived as Parquet (DuckDB) under the
# cold_storage/ prefix of the bucket above (GLITCHTIP_COLD_STORAGE_BUCKET
# defaults to AWS_STORAGE_BUCKET_NAME).
# Docs: https://glitchtip.com/documentation/install#cold-storage
GLITCHTIP_ENABLE_DUCKDB=true
